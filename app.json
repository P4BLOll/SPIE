{
  "expo": {
    "name": "spie-app",
    "slug": "spie-app",
    "scheme": "com.pablo.spieapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B111E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pablo.spieapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/logo.png"
      },
      "package": "com.pablo.spieapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SEND_SMS",
        "android.permission.CALL_PHONE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ],
      "statusBar": {
        "backgroundColor": "#0B111E",
        "barStyle": "light-content",
        "translucent": true
      }
    },
    "package": "com.pablo.spieapp",
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que o SPIE acesse sua localização para identificar sua posição durante uma emergência."
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "O SPIE precisa de acesso contínuo ao Bluetooth para detectar os sinais de emergência da pulseira."
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que o SPIE acesse suas fotos para você escolher sua foto de perfil.",
          "cameraPermission": "Permitir que o SPIE acesse sua câmera para você tirar uma foto de perfil."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
